{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*",
    "../engine/*.ts"
  ],
  "exclude": [
    "../engine/tests"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engine/*": ["../engine/*"],
      "@data/*": ["../data/*"]
    },
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  }
}
