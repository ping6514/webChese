{
  "name": "app4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "npx tsx src/sim/report.ts",
    "sim:quick": "npx tsx src/sim/report.ts 50",
    "train": "npx tsx src/sim/train.ts",
    "train:quick": "npx tsx src/sim/train.ts --quick",
    "train:night": "npx tsx src/sim/train.ts --rounds=20"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2",
    "vue": "^3.5.30",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.5"
  }
}
